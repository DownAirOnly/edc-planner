rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all access except an authenticated user's own schedule and profile.
    match /users/{uid}/data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid && docId == 'schedule';
    }
    match /users/{uid}/settings/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid && docId == 'profile';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
